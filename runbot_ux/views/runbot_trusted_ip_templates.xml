<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="trusted_ip_page">
        <t t-call="runbot.layout">
            <div class="container my-4" style="max-width: 720px;">
                <h3>Test server actions on live builds</h3>
                <p>
                    Live builds block server actions, crons, automations, fields and module imports.
                    Trust your IP to unlock them on every live build until midnight (Argentina time).
                </p>
                <div class="alert alert-warning">
                    <strong>Before you continue:</strong>
                    anyone who shares your public IP gets the same access until midnight.
                    Do not do this from mobile data, public wifi or a VPN: there your IP is shared with strangers.
                </div>
                <div t-if="saved" class="alert alert-success">
                    <t t-out="ip"/> is trusted until midnight. In about a minute, once the runbot reloads nginx, it can write code on any live build.
                </div>
                <div t-if="error" class="alert alert-danger" t-out="error"/>
                <form method="post" action="/runbot/trusted_ip">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label for="ip" class="form-label">Your public IP</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="ip" name="ip" t-att-value="ip" required="required"/>
                        <button type="submit" class="btn btn-primary">Trust this IP</button>
                    </div>
                    <div class="form-text">This is the IP the runbot sees for you. Leave it as it is.</div>
                </form>
            </div>
        </t>
    </template>

    <template id="layout_trusted_ip_menu" inherit_id="runbot.layout">
        <xpath expr="//div[hasclass('js_usermenu')]/a[@id='o_logout']" position="after">
            <a t-if="user_id._is_internal()" class="dropdown-item" role="menuitem" href="/runbot/trusted_ip">Test server actions</a>
        </xpath>
    </template>
</odoo>
