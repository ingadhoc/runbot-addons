<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="build_menu_https" inherit_id="runbot.build_menu">
        <!-- The host nginx and Cloudflare block /web/database -->
        <xpath expr="//a[contains(@t-attf-href, '/web/database/selector')]" position="replace"/>
        <xpath expr="//a[contains(@t-attf-href, '/logs/#{log_name}.txt')]" position="attributes">
            <attribute name="t-attf-href">{{bu.sudo()._http_log_url()}}{{log_name}}.txt</attribute>
        </xpath>
    </template>
</odoo>
