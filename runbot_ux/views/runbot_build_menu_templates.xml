<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="build_menu_https" inherit_id="runbot.build_menu">
        <!-- The host nginx and Cloudflare block /web/database -->
        <xpath expr="//li[a[contains(@href, '/web/database/selector')]]" position="replace"/>
        <xpath expr="//a[contains(@href, '/logs/{{log_name}}.txt')]" position="attributes">
            <attribute name="href">{{log_url}}{{log_name}}.txt</attribute>
        </xpath>
    </template>

    <template id="build_menu_button_https" inherit_id="runbot.build_menu_button">
        <xpath expr="//build-options-dropdown" position="attributes">
            <attribute name="t-att-data-log_url">bu.sudo()._http_log_url() if bu.host else ''</attribute>
        </xpath>
    </template>
</odoo>
