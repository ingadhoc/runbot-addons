<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="runbot_build_form_vscode" model="ir.ui.view">
        <field name="name">runbot.build.form.vscode</field>
        <field name="model">runbot.build</field>
        <field name="inherit_id" ref="runbot.build_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="VS Code sessions"
                       invisible="not vscode_session_ids">
                    <field name="vscode_session_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="port"/>
                            <field name="container_name"/>
                            <field name="last_seen"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
