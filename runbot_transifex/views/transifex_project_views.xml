<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="transifex_project_view_form" model="ir.ui.view">
        <field name="name">transifex.project.view.form</field>
        <field name="model">transifex.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <field name="slug"/>
                        <field name="organization_slug"/>
                        <field name="tx_token" widget="password"/>
                        <field name="branch_ids" widget="many2many" options="{'no_create': True}">
                            <list>
                                <field name="repo_id"/>
                                <field name="remote_id"/>
                                <field name="name"/>
                                <field name="last_sync_date"/>
                                <field name="next_sync_date"/>
                                <button name="sync_translations_to_github" type="object" icon="fa-refresh"
                                    title="Sync translations to GitHub"
                                    help="Sincroniza traducciones desde transifex a github sin verificar fecha"
                                    confirm="Sicroniza traducciones desde transifex a github sin verificar fecha.
                                    El timeout del httpworker puede hacer que el proceso no se complete.
                                    Se sugiere borrar Next Sync Date y esperar a que el cron lo ejecute. ¿Desea continuar igualmente?"/>
                                <button name="get_push_data" type="object" icon="fa-arrow-up"
                                    title="Get push data"
                                    help="Get push data"
                                    groups="base.group_no_one"/>
                            </list>
                        </field>
                    </group>
                    <group string="Sync to Transifex">
                        <field name="periodicity"/>
                        <field name="github_token"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="transifex_project_view_tree" model="ir.ui.view">
        <field name="model">transifex.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="slug"/>
                <field name="organization_slug"/>
            </list>
        </field>
    </record>

    <record id="transifex_project_view_search" model="ir.ui.view">
        <field name="model">transifex.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="slug"/>
                <field name="organization_slug"/>
            </search>
        </field>
    </record>

    <record id="transifex_project_act" model="ir.actions.act_window">
        <field name="name">Transifex</field>
        <field name="res_model">transifex.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_transifex" name="Transifex" action="transifex_project_act"/>

</odoo>
